# Firegate NFTables Configuration - VLAN 10

table inet vlan10 {
	chain input {
		type filter hook input priority filter + 10; policy accept;
		
		# Allow DNS
		ip saddr 172.16.10.0/24 udp dport 53 ct state new accept
		ip saddr 172.16.10.0/24 tcp dport 53 ct state new accept
		
		# Allow Web GUI Access
		ip saddr 172.16.10.0/24 tcp dport 443 ct state new accept
		
		# Allow SSH
		ip saddr 172.16.10.0/24 tcp dport 22 accept
		
		ip saddr 172.16.10.0/24 drop
		
	}
	
	chain forward {
		type filter hook forward priority filter + 10; policy accept;
		
		# Unrestricted Internet Access
		ip saddr 172.16.10.0/24 oifname "eth0" ct state new accept
			
		ip saddr 172.16.10.0/24 drop
		
	}
}
