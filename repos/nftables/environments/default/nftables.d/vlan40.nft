# Firegate NFTables Configuration - VLAN 40 (Tor-Routed)

table inet vlan40 {
	chain input {
		type filter hook input priority filter + 10; policy accept;
			
		# No Firewall Access needed
		ip saddr 172.16.40.0/24 drop
		
	}
	
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		
		# Tor Routing
		ip saddr 172.16.40.0/24 udp dport 53 redirect to :5353
		ip saddr 172.16.40.0/24 tcp dport 53 redirect to :5353
		
		ip saddr 172.16.40.0/24 tcp dport { 21, 22, 80, 443, 8080 } redirect to :9040
	}	
	chain forward {
		type filter hook forward priority filter + 10; policy accept;
			
		# Unrestricted Internet Access
		ip saddr 172.16.40.0/24 oifname "eth0" ct state new accept
			
		ip saddr 172.16.40.0/24 drop
		
	}
}
