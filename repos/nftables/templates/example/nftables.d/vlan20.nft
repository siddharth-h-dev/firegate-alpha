# Firegate NFTables Configuration - VLAN 20 (Personal)

table inet vlan20 {
	chain input {
		type filter hook input priority filter + 10; policy accept;
			
		# Allow DNS
		ip saddr 172.16.20.0/24 udp dport 53 ct state new accept
		ip saddr 172.16.20.0/24 tcp dport 53 ct state new accept
		
		# Allow Web GUI Access
		ip saddr 172.16.20.0/24 tcp dport 443 ct state new accept
		
		ip saddr 172.16.20.0/24 drop
		
	}
	
	chain forward {
		type filter hook forward priority filter + 10; policy accept;
			
		# Unrestricted Internet Access
		ip saddr 172.16.20.0/24 oifname "eth0" ct state new accept
			
		ip saddr 172.16.20.0/24 drop
		
	}
}
