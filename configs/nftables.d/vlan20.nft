# Firegate NFTables Configuration - VLAN 20 (Personal)

define vlan20-net = 172.16.20.0/24

table inet vlan20 {
	chain input {
		type filter hook input priority filter + 10; policy drop;
		
		# Allow DNS
		ip saddr $vlan20-net udp dport 53 ct state new accept
		ip saddr $vlan20-net tcp dport 53 ct state new accept
		
		# Allow Web GUI Access
		ip saddr $vlan20-net tcp dport 443 ct state new accept
		
		ip saddr $vlan20-net drop
		
	}
	
	chain forward {
		type filter hook forward priority filter + 10; policy drop;
		
		# VLAN Isolation
		ip saddr $vlan20-net ip daddr $lan-net ip daddr != $vlan20-net drop
			
		# Unrestricted Internet Access
		ip saddr $vlan20-net oifname $wan-iface ct state new accept
			
		ip saddr $vlan20-net drop
		
	}
}
