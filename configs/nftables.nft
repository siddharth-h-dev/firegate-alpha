#!/usr/sbin/nft -f

# Firegate NFTables Configuration - Core Filtering and NAT

flush ruleset

define lan-net = 172.16.0.0/12
define wan-iface = "eth0"

table inet core {

	chain input {
		type filter hook input priority filter; policy drop;
		
		ct state established,related accept
		ct state invalid drop
		
		iifname "lo" accept
		ip protocol icmp accept
		
		ip saddr $lan-net continue
		
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		
		ct state established,related accept
		ct state invalid drop
		
		ip saddr $lan-net continue
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}
	
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		
		oif $wan-iface masquerade
	}
}

include "/etc/nftables.d/*.nft"

# Insurance: Takes care of accidents
table inet insurance {
	chain input {
		type filter hook input priority filter + 20; policy drop;
	}
	chain forward {
		type filter hook forward priority filter + 20; policy drop;
	}
}
