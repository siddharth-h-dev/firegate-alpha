# Firegate NFTables Configuration

#!/usr/sbin/nft -f

# Core Filtering
table inet core {
	chain input {
		type filter hook input priority filter; policy drop;
		
		ct state established,related accept	
		ct state invalid drop

		iifname "lo" accept
	
		ip saddr 172.16.20.0/24 udp dport 53 accept
		ip saddr 172.16.20.0/24 tcp dport { 53, 443 } accept
		
		# Allow VLAN 10 to access SSH
		# Debugging Purpouses
		ip protocol icmp accept

		ct state new accept	
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		
		ct state established,related accept
		ct state invalid drop
		ct state new accept
		
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}

}

table ip nat {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		
		oifname "eth0" masquerade
	}
}

# Example VLANs

# VLAN 10 (Infrastructure)
table inet vlan10 {
	chain input {
		type filter hook input priority filter + 10;

		ip saddr != 172.16.10.0/24 return
		
		# Allow DNS		
		ip saddr 172.16.10.0/24 udp dport 53 accept
		ip saddr 172.16.10.0/24 tcp dport 53 accept
		
		# Allow Web GUI Access
		ip saddr 172.16.10.0/24 tcp dport 443 accept
		
		# Allow SSH
		ip saddr 172.16.10.0/24 tcp dport 22 accept
		
		ip saddr 172.16.10.0/24 drop
	}

	chain forward {
		type filter hook forward priority filter + 10;
	
		ip saddr != 172.16.10.0/24 return
		
		# Unrestricted Internet Aceess
		ip saddr 172.16.10.0/24 oifname "eth0" accept	
		
		ip saddr 172.16.10.0/24 drop
	}
}

# VLAN 20 (Personal Devices)
table inet vlan20 {
	chain input {
		type filter hook input priority filter + 10;
		
		ip saddr != 172.16.20.0/24 return
		
		# Allow DNS
		ip saddr 172.16.20.0/24 udp dport 53 accept
		ip saddr 172.16.20.0/24 tcp dport 53 accept
		
		# Allow Web GUI Access
		ip saddr 172.16.20.0/24 tcp dport 443 accept
		
		ip saddr 172.16.20.0/24 drop
	}
	
	chain forward {
		type filter hook forward priority filter + 10;
		
		ip saddr != 172.16.20.0/24 return
		
		# Unrestricted Internet Aceess
		ip saddr 172.16.20.0/24 oifname "eth0" accept
		
		ip saddr 172.16.20.0/24 drop
	}
}

# VLAN 30 (Guest Network)
table inet vlan30 {
	chain input {
		type filter hook input priority filter + 10;
		
		ip saddr != 172.16.30.0/24 return
		
		# No Firewall Access at all (Can be opened up if needed but this is the most secure, DNS can be configured to another server in L3 switch)
		ip saddr 172.16.30.0/24 drop
	}
	
	chain forward {
		type filter hook forward priority filter + 10;
		
		ip saddr != 172.16.30.0/24 return
		
		# Unrestricted Internet Access (Egress filtering can be applied but this causes least bugs)
		ip saddr 172.16.30.0/24 oifname "eth0" accept
		
		ip saddr 172.16.30.0/24 drop
	}
}

# VLAN 40 (Tor-routed VLAN)
table inet vlan40 {
	chain input {
		type filter hook input priority filter + 10;
		
		ip saddr != 172.16.40.0/24 return
		
		# No Firewall Access at all
		ip saddr 172.16.40.0/24 drop
	}
	
	chain forward {
		type filter hook forward priority filter + 10;
		
		ip saddr != 172.16.40.0/24 return
		
		# Unrestricted Internet Aceess
		ip saddr 172.16.40.0/24 oifname "eth0" accept
		
		ip saddr 172.16.40.0/24 drop
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		
		# Tor Routing		
		ip saddr 172.16.40.0/24 udp dport 53 counter redirect to :5353
		ip saddr 172.16.40.0/24 tcp dport 53 counter redirect to :5353

		ip saddr 172.16.40.0/24 tcp dport { 21, 22, 80, 443, 8080 } counter redirect to :9040
	}
}

# VLAN 50 (Isolated Lab Network)
table inet vlan50 {
	chain input {
		type filter hook input priority filter + 10;
		
		ip saddr != 172.16.50.0/24 return
		
		# No Firewall Access at all
		ip saddr 172.16.50.0/24 drop
	}
	
	chain forward {
		type filter hook forward priority filter + 10;
		
		ip saddr != 172.16.50.0/24 return
		
		# No Internet Aceess at all
		ip saddr 172.16.50.0/24 drop
	}

}
