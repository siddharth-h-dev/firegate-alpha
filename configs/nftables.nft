# Firegate NFTables Configuration

#!/usr/sbin/nft -f

table inet firegate_filter {
	chain input {
		type filter hook input priority filter; policy drop;
	
		iifname "lo" accept
	
		ct state established,related accept
		
		# Allow VLAN 10 and 20 DNS Requests and Web GUI Access
		ip saddr 172.16.10.0/24 udp dport 53 accept
		ip saddr 172.16.10.0/24 tcp dport { 53, 443 } accept
		ip saddr 172.16.20.0/24 udp dport 53 accept
		ip saddr 172.16.20.0/24 tcp dport { 53, 443 } accept
		
		# Allow VLAN 10 to access SSH
		ip saddr 172.16.10.0/24 tcp dport 22 accept
		# Debugging Purpouses
		ip protocol icmp accept
	
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		
		ct state established,related accept

		ct state invalid drop

		# EXAMPLE VLANS CONFIG
		# VLAN 10 - Infrastructure
		ip saddr 172.16.10.0/24 oifname "eth0" ct state new accept
		
		# VLAN 20 - Personal
		ip saddr 172.16.20.0/24 oifname "eth0" ct state new accept
		
		# VLAN 30 - Guest (Internet access can be restricted if needed)
		ip saddr 172.16.30.0/24 oifname "eth0" ct state new accept
		
		# VLAN 40 - Anonymous
		ip saddr 172.16.40.0/24 oifname "eth0" ct state new accept

		# Config for no VLANs
		# ip saddr 172.16.0.0/12 oifname "eth0" accept
		# iifname "eth0" ip daddr 172.16.0.0/12 ct state established,related accept
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}

}

table ip firegate_nat {
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		
		oifname "eth0" masquerade
	}
}

table ip tor_proxy {
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		
		# VLAN 40 Tor Routing		
		ip saddr 172.16.40.0/24 udp dport 53 counter redirect to :5353
		ip saddr 172.16.40.0/24 tcp dport 53 counter redirect to :5353

		ip saddr 172.16.40.0/24 tcp dport { 21, 22, 80, 443, 8080 } counter redirect to :9040
	}
}
